        "row": 1,
        "sizey": 4
      },
      "config": {
        "displaySettings": {},
        "isSupportCustomProperty": false,
        "supportCustomProperty": false,
        "name": "Simple Device List Example",
        "description": "",
        "theme": "newBorderGray",
        "interval": 15,
        "type": "text",
        "timescale": "day",
        "version": 2,
        "content": "<!--\n\tBasic example of a LogicMonitor Text/Custom HTML widget using the LogicMonitor Widget SDK.\n\tThis widget will display a list of devices in alert status, as well as a summary of the number of devices in alert status and the number of alerts that have not cleared.\n\n\tSDK commands this script helps demonstrate:\n\t- lm.auth.fromTokens()\n\t- lm.configure()\n\t- lm.context.onReady()\n\t- lm.error()\n\t- lm.getAlerts()\n\t- lm.info()\n\t- lm.query()\n--><!-- Capture optional API tokens containing LogicMonitorAPI credentials or a bearer token. If not specified then the widget will use integrated authentication. --><div id=\"apiBearerTokenToken\" style=\"display:none;\">##apiBearerToken##</div><div id=\"apiIDToken\" style=\"display:none;\">##apiID##</div><div id=\"apiKeyToken\" style=\"display:none;\">##apiKey##</div><h3>Devices in alert</h3><!-- Containers are not empty because LogicMonitor's editor strips empty elements. The script replaces this text... --><div id=\"deviceList\">Loading devices...</div><div id=\"status\">&nbsp;</div><!-- Load the lm SDK, which exposes a global \"lm\" object... --><script src=\"https://cdn.jsdelivr.net/gh/logicmonitor/custom_widgets@main/sdk/lm-sdk.js\"></script><script>\n\t// Runs after the widget has finished rendering...\n\tlm.context.onReady(async function () {\n\t\t// Set a name for log messages and the minimum log level to write to the console...\n\t\tlm.configure({ widgetName: \"Device List Example\", logLevel: \"info\" });\n\n\t\t// Uses the credentials above when supplied; otherwise falls back to the integrated portal session...\n\t\tlm.info(\"Auth mode: \" + lm.auth.fromTokens());\n\n\t\t// Get the elements we will fill in...\n\t\tvar container = document.getElementById(\"deviceList\");\n\t\tvar status = document.getElementById(\"status\");\n\n\t\ttry {\n\t\t\t// Build a devices API query: only devices whose alert status is not \"none\", returning just three fields, sorted by name, max 200...\n\t\t\t// getItems() pages through the API as needed and returns a flat array of devices...\n\t\t\tvar devices = await lm.query(\"devices\")\n\t\t\t\t.addQuery(\"alertStatus\", \"!=\", \"none\")\n\t\t\t\t.fields(\"id,displayName,alertStatus\")\n\t\t\t\t.orderBy(\"displayName\")\n\t\t\t\t.limit(200)\n\t\t\t\t.getItems();\n\n\t\t\t// Replace the loading text with a list built here, with one item per device showing its name and alert status...\n\t\t\tvar list = document.createElement(\"ul\");\n\t\t\tcontainer.textContent = \"\";\n\t\t\tcontainer.appendChild(list);\n\t\t\tdevices.forEach(function (d) {\n\t\t\t\tvar li = document.createElement(\"li\");\n\t\t\t\tli.textContent = d.displayName + \" (\" + d.alertStatus + \")\";\n\t\t\t\tlist.appendChild(li);\n\t\t\t});\n\n\t\t\t// Fetch up to 100 alerts that have not cleared, requesting only the fields we need...\n\t\t\tvar active = await lm.getAlerts({ filter: [[\"cleared\", \"=\", false]], maxItems: 100, fields: \"id,monitorObjectName,severity\" });\n\t\t\t\n\t\t\t// Show a summary of the counts below the list...\n\t\t\tstatus.textContent = devices.length + \" devices, \" + active.length + \" active alerts (latest 100).\";\n\t\t\tlm.info(\"Rendered \" + devices.length + \" devices.\");\n\t\t} catch (e) {\n\t\t\t// Show the error on the widget and also log it through the SDK...\n\t\t\tstatus.textContent = \"Error: \" + e.message;\n\t\t\tlm.error(e);\n\t\t}\n\t});\n</script>"
      }
    },
    {
      "position": {
        "col": 5,
