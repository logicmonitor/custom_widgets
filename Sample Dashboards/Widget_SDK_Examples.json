        "row": 9,
        "sizey": 3
      },
      "config": {
        "displaySettings": {},
        "isSupportCustomProperty": false,
        "supportCustomProperty": false,
        "name": "Section Header Widget",
        "description": "",
        "theme": "newBorderGray",
        "interval": 3,
        "type": "text",
        "timescale": "day",
        "version": 2,
        "content": "<p><span style=\"color: rgb(124, 112, 107);\">What you&#39;re reading is the Section Header example in action. It was created using the LogicMonitor Custom Widget SDK to apply some custom styles to this Text widget and its parent container.</span></p><!-- Put any HTML you want to display here above the script. --><!--\n\tLogicMonitor Header Widget (SDK version)\n\tVersion 2.0.0\n\tDeveloped by Kevin Ford\n\n\tA \"header\" widget type to help separate vertical sections of a LogicMonitor dashboard. This version is built on the LogicMonitor Widget SDK (lm) and doubles as an example of the SDK's styling and size-watching functions in lm.context.\n\n\tWhat the script does:\n\t* Hides the widget's background so it blends seamlessly with the dashboard itself.\n\t* Enlarges the widget's title so it can act as the section header (the text in the widget body can be used for extra detail).\n\t* Adds a bottom border to the widget so it's visually separated from the widgets below it.\n\t* Adds a hover effect to the widget so it's easy to tell when the widget is being hovered over.\n\t* Watches for size changes and resizes the widget to fit its content.\n\n\tSDK functions demonstrated:\n\t* lm.context.onReady          - wait for the widget to finish rendering.\n\t* lm.context.widgetContainer / widgetTitle / widgetParent / widgetFrame - locate the widget's elements in the dashboard.\n\t* lm.context.setStyleIfChanged - change inline styles without triggering needless layout cycles.\n\t* lm.context.injectParentStyle - add CSS to the dashboard page (the widget card lives outside this iframe).\n\t* lm.context.injectStyle      - add CSS to this widget's own content.\n\t* lm.context.observeSize      - react to size changes (throttled to once per animation frame).\n\t* lm.context.fitFrameToContent / resizeFrame - size the iframe to match its content (growing and shrinking).\n\n\tPrerequisites:\n\t* The 'Allow Scripts in Dashboard Text Widgets' setting must be enabled in your portal's Settings > Security section.\n\n\tTO USE:\n\t1. Add a new Text widget to the dashboard. I highly recommend making it the full width of the dashboard and the smallest height necessary.\n\t2. On the Text widget's edit dialog, click the \"Source\" button and paste in the contents of this file, then save the widget.\n\t3. You can then edit the text of the widget using LogicMonitor's usual Text widget editing tools. LogicMonitor's HTML editor should leave the scripts intact, but you might have to re-paste them if the editor accidentally removes them.\n--><script src=\"https://cdn.jsdelivr.net/gh/logicmonitor/custom_widgets@main/sdk/lm-sdk.js\"></script><script>\n\t// Configuration...\n\tvar CONFIG = {\n\t\tminWidgetHeight: \"50px\",     // Smallest height the widget will shrink to.\n\t\ttitleHeight: \"35px\",         // Height of the title text (this is also the height of the widget).\n\t\ttitleFontSize: \"xx-large\",   // Font size of the title text.\n\t\tborderColor: \"black\",        // Color of the border below the widget.\n\t\thoverBorderColor: \"#ddd\"     // Color of the border when the widget is hovered over.\n\t};\n\n\t// If a LogicMonitor update breaks widget or title lookups, override the SDK's selectors here, e.g.:\n\t// lm.context.selectors.title = \"h2.newTitleClass\";\n\n\tvar ctx = lm.context;\n\tvar stopObserving = null;\n\n\tlm.context.onReady(function () {\n\t\tlm.configure({ widgetName: \"Dashboard Header\" });\n\t\tinitializeWidget();\n\t});\n\n\tfunction initializeWidget() {\n\t\tvar card = ctx.widgetContainer();\n\t\tif (!card || !ctx.isEmbedded()) {\n\t\t\tlm.warn(\"Containing widget not found; aborting initialization.\");\n\t\t\treturn;\n\t\t}\n\n\t\t// Style the dashboard page: the card lives outside this iframe, so its hover rule goes in the parent document.\n\t\t// !important is needed because styleWidget() sets the border as an inline style.\n\t\t// Everything here is safe to repeat (the card keeps its styles when this iframe reloads, e.g. after an edit),\n\t\t// and re-applying it on every load replaces any stale values left by an earlier version of this script.\n\t\tvar border = \"1px solid \" + CONFIG.hoverBorderColor + \" !important;\";\n\t\tctx.injectParentStyle(\"dashboardHeaderWidgetStyle\",\n\t\t\t\".dashboardHeaderWidget:hover { border-top: \" + border + \" border-left: \" + border + \" border-right: \" + border + \" }\");\n\t\tcard.classList.add(\"dashboardHeaderWidget\");\n\n\t\tstyleWidget();\n\n\t\t// Style this widget's own content (inside the iframe)...\n\t\tctx.injectStyle(\"dashboardHeaderContentStyle\", \"body { margin: 0; }\");\n\n\t\tsyncWidgetHeight();\n\n\t\t// Watch for size changes in the content (e.g. dashboard width changes that re-wrap the text)...\n\t\t// Vertical resizing needs no watching: the card fills its grid cell by percentage (see styleWidget).\n\t\tif (stopObserving) stopObserving();\n\t\tvar stopContent = ctx.observeSize(syncWidgetHeight);\n\t\tstopObserving = function () { stopContent(); stopObserving = null; };\n\t\twindow.addEventListener(\"pagehide\", function () { if (stopObserving) stopObserving(); }, { once: true });\n\t}\n\n\t// Apply our own styles to the widget card, title and grid cell...\n\tfunction styleWidget() {\n\t\tvar set = ctx.setStyleIfChanged;\n\n\t\tvar card = ctx.widgetContainer();\n\t\tset(card, \"backgroundColor\", \"unset\");\n\t\tset(card, \"border\", \"none\");\n\t\tset(card, \"borderRadius\", \"0\");\n\t\tset(card, \"borderBottom\", \"1px solid \" + CONFIG.borderColor);\n\n\t\t// Fill the grid cell exactly. A percentage height tracks the cell as the dashboard resizes it, so no resize\n\t\t// watching is needed. The empty strings clear values left on the card by earlier versions of this script.\n\t\tset(card, \"height\", \"100%\");\n\t\tset(card, \"minHeight\", CONFIG.minWidgetHeight);\n\t\tset(card, \"maxHeight\", \"\");\n\t\tset(card, \"alignSelf\", \"\");\n\t\tset(card, \"flexShrink\", \"\");\n\n\t\t// Something must remain in the title for the widget to still be movable, so it is styled rather than removed.\n\t\tvar title = ctx.widgetTitle();\n\t\tif (title) {\n\t\t\tset(title, \"fontSize\", CONFIG.titleFontSize);\n\t\t\tset(title, \"height\", CONFIG.titleHeight);\n\t\t\tset(title.parentElement, \"height\", CONFIG.titleHeight);\n\t\t\tset(title.parentElement, \"alignItems\", \"flex-end\");\n\n\t\t\t// The title row and the widget's iframe sit in a flex column that fills the card. To keep the header text\n\t\t\t// just above the bottom border when the card is taller than its content, push the title row (the column's\n\t\t\t// first child) down with an auto top margin. Unlike justify-content: flex-end, an auto margin collapses to\n\t\t\t// zero when the content is too tall, so the title stays at the top, in view, instead of being pushed out of\n\t\t\t// the card. (The empty string clears the justify-content set by an earlier version of this script.)\n\t\t\tvar column = title.closest(\"section\");\n\t\t\tif (column) {\n\t\t\t\tset(column, \"justifyContent\", \"\");\n\t\t\t\tif (column.firstElementChild) set(column.firstElementChild, \"marginTop\", \"auto\");\n\t\t\t}\n\t\t} else {\n\t\t\tlm.warn(\"Widget title element not found; skipping title styling.\");\n\t\t}\n\n\t\tvar cell = ctx.widgetParent();\n\t\tif (cell) {\n\t\t\tset(cell, \"border\", \"none\");\n\t\t\tset(cell, \"display\", \"flex\");\n\t\t\tset(cell, \"alignItems\", \"flex-end\"); // Align the header's content to the bottom of the widget.\n\t\t\tset(cell, \"backgroundColor\", \"unset\");\n\t\t}\n\t}\n\n\t// Size the iframe to the height of the content. (The card itself is sized by the dashboard, see styleWidget.)\n\tfunction syncWidgetHeight() {\n\t\t// Treat the widget as empty only if there's no text and no visual content...\n\t\tvar hasText = document.body.innerText.trim() !== \"\";\n\t\tvar hasMedia = document.body.querySelector(\"img, video, iframe, canvas, svg, table, hr\") !== null;\n\n\t\tif (!hasText && !hasMedia) {\n\t\t\tlm.debug(\"Frame content is empty, collapsing frame\");\n\t\t\tctx.resizeFrame(0);\n\t\t} else {\n\t\t\t// Size the iframe to its content (growing or shrinking)...\n\t\t\tvar frameHeight = ctx.fitFrameToContent();\n\t\t\tlm.debug(\"Frame height \" + frameHeight + \"px\");\n\t\t}\n\t}\n</script>"
      }
